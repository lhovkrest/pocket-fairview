{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/controller",
      "destination": "/controller/index.html"
    },
    {
      "source": "/pvp",
      "destination": "/pvp/index.html"
    },
    {
      "source": "/pvp/controller",
      "destination": "/pvp/controller.html"
    },
    {
      "source": "/solo",
      "destination": "/solo/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}